local Visual = {
    Settings = {
        MasterEnabled = true,
        Names = { Enabled = false, Color = Color3.fromRGB(255, 0, 0) },
        Tracers = { Enabled = false, Color = Color3.fromRGB(255, 0, 0) },
        Health = { Enabled = false },
        Highlight = { Enabled = false, Color = Color3.fromRGB(255, 0, 0) },
        Box = { Enabled = false, Color = Color3.fromRGB(255, 0, 0) },
        TeamColors = {}
    },
    Classes = {},
    Objects = {},
    GetTeam = function(player) return "Neutral" end,
    GetTeamClass = function(player) return nil end,
}

-- Services
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local LocalPlayer = Players.LocalPlayer

-- Cached constants (avoid re-allocating every frame)
local HUMANOID_SIZE   = Vector3.new(4, 5.5, 3)
local HEALTH_BG_COLOR = Color3.fromRGB(40, 40, 40)
local HEALTH_LOW      = Color3.fromRGB(255, 0, 0)
local HEALTH_HIGH     = Color3.fromRGB(0, 255, 0)

-- Unique seed generator
local seedCounter = 0
local function generateSeed()
    seedCounter = seedCounter + 1
    return "VisualObj_" .. tostring(seedCounter)
end

-- Cleanly removes drawing structures and highlights from a specific entry
local function clearVisualElements(entry)
    if entry.Drawing then
        for _, drawingObj in pairs(entry.Drawing) do
            drawingObj.Visible = false
            drawingObj:Remove()
        end
        entry.Drawing = nil
    end
    if entry.HighlightInstance then
        entry.HighlightInstance:Destroy()
        entry.HighlightInstance = nil
    end
end

-- Hide (but keep) every visual element for an entry
local function hideEntry(entry)
    if entry.Drawing then
        for _, d in pairs(entry.Drawing) do d.Visible = false end
    end
    if entry.HighlightInstance then
        entry.HighlightInstance.Enabled = false
    end
end

-- Computes the 2D screen box in ONE place.
-- Returns: boxPos, boxSize, centerScreen, onScreen  (nil if not projectable this frame)
local function computeScreenBox(camera, object, isHumanoid)
    local position, size
    if isHumanoid then
        local hrp = object:FindFirstChild("HumanoidRootPart")
        if not hrp then return nil end          -- transient (mid-respawn), just hide
        position = hrp.Position
        size = HUMANOID_SIZE
    elseif object:IsA("Model") then
        local cf, sz = object:GetBoundingBox()   -- expensive: now called ONCE per frame
        position = cf.Position
        size = sz
    elseif object:IsA("BasePart") then
        position = object.Position
        size = object.Size
    else
        return nil
    end

    local halfX, halfY = size.X * 0.5, size.Y * 0.5
    local tl, onTL = camera:WorldToViewportPoint(position + Vector3.new(-halfX,  halfY, 0))
    local br, onBR = camera:WorldToViewportPoint(position + Vector3.new( halfX, -halfY, 0))

    -- Fully behind the camera -> nothing to draw
    if tl.Z <= 0 and br.Z <= 0 then
        return nil, nil, nil, false
    end

    local minX   = math.min(tl.X, br.X)
    local minY   = math.min(tl.Y, br.Y)
    local width  = math.abs(tl.X - br.X)
    local height = math.abs(tl.Y - br.Y)

    return Vector2.new(minX, minY),
           Vector2.new(width, height),
           Vector2.new(minX + width * 0.5, minY + height * 0.5),
           (onTL or onBR)
end

-- Rule resolution (hoisted to module scope so it is NOT re-allocated every frame/entry)
local function resolveSetting(classConfig, dynamicColor, category, key)
    if classConfig then
        local cc = classConfig[category]
        if cc and cc[key] ~= nil then return cc[key] end
    end
    if category ~= "Health" and key == "Color" and dynamicColor then
        return dynamicColor
    end
    local s = Visual.Settings[category]
    if s and s[key] ~= nil then return s[key] end
    return nil
end

Visual.RegisterClass = function(className, settingsTable)
    Visual.Classes[className] = settingsTable or {}
    if Visual.Classes[className].Enabled == nil then
        Visual.Classes[className].Enabled = true
    end
    return Visual.Classes[className]
end

--[[
    Visual.Create
    - objectOrPlayer: Accepts a Model, BasePart, OR a Player Instance!
    - isHumanoid: Boolean determining if health calculations apply
    - color: (Optional) Override static color
    - name: (Optional) Explicit naming text override
    - className: (Optional) Target registered class name string
]]
Visual.Create = function(objectOrPlayer, isHumanoid, color, name, className)
    if not objectOrPlayer then return end

    local seed = generateSeed()
    local entry = {
        IsHumanoid = isHumanoid,
        OverriddenColor = color,
        ClassName = className,
        Drawing = {},
        HighlightInstance = nil,
        Connections = {}
    }

    if objectOrPlayer:IsA("Player") then
        entry.Player = objectOrPlayer
        entry.Name = name or objectOrPlayer.Name
        entry.Object = objectOrPlayer.Character

        local conn = objectOrPlayer.CharacterAdded:Connect(function(newCharacter)
            task.wait(0.2)
            if Visual.Objects[seed] then
                clearVisualElements(Visual.Objects[seed])
                Visual.Objects[seed].Object = newCharacter
            end
        end)
        table.insert(entry.Connections, conn)

        local connRemove = objectOrPlayer.CharacterRemoving:Connect(function()
            if Visual.Objects[seed] then
                clearVisualElements(Visual.Objects[seed])
                Visual.Objects[seed].Object = nil
            end
        end)
        table.insert(entry.Connections, connRemove)
    else
        entry.Object = objectOrPlayer
        entry.Name = name or objectOrPlayer.Name
    end

    Visual.Objects[seed] = entry
    return seed
end

Visual.Remove = function(seed)
    local entry = Visual.Objects[seed]
    if entry then
        clearVisualElements(entry)
        if entry.Connections then
            for _, conn in ipairs(entry.Connections) do
                conn:Disconnect()
            end
        end
        Visual.Objects[seed] = nil
    end
end

Visual.RemoveClass = function(className)
    for seed, entry in pairs(Visual.Objects) do
        if entry.ClassName == className then
            Visual.Remove(seed)
        end
    end
end

Visual.Update = function(seed, color, name)
    local entry = Visual.Objects[seed]
    if entry then
        if color then entry.OverriddenColor = color end
        if name then entry.Name = name end
    end
end

-- Allocates the reusable drawing objects for an entry (only when first needed)
local function ensureDrawings(entry)
    if entry.Drawing and entry.Drawing.Box then return end
    entry.Drawing = entry.Drawing or {}
    local D = entry.Drawing

    D.Box = Drawing.new("Square")
    D.Box.Thickness = 1
    D.Box.Filled = false

    D.Tracer = Drawing.new("Line")
    D.Tracer.Thickness = 1

    D.HealthBarBG = Drawing.new("Square")
    D.HealthBarBG.Filled = true
    D.HealthBarBG.Thickness = 0

    D.HealthBar = Drawing.new("Square")
    D.HealthBar.Filled = true
    D.HealthBar.Thickness = 0

    D.Name = Drawing.new("Text")
    D.Name.Size = 14
    D.Name.Center = true
    D.Name.Outline = true
end

-- Master Render Tick
local visualsHidden = false
RunService.RenderStepped:Connect(function()
    -- Global killswitch handled ONCE, outside the per-entry loop.
    if not Visual.Settings.MasterEnabled then
        if not visualsHidden then
            for _, entry in pairs(Visual.Objects) do hideEntry(entry) end
            visualsHidden = true
        end
        return
    end
    visualsHidden = false

    local camera = Workspace.CurrentCamera
    if not camera then return end

    local viewportSize = camera.ViewportSize
    local screenBottomCenter = Vector2.new(viewportSize.X * 0.5, viewportSize.Y)

    for seed, entry in pairs(Visual.Objects) do
        local targetPlayer = entry.Player
        local obj = entry.Object

        -- Cleanup / skip conditions
        if targetPlayer then
            if not targetPlayer.Parent then
                Visual.Remove(seed)
                continue
            end
            if not obj or not obj.Parent then
                hideEntry(entry)      -- player alive but no character right now (respawning)
                continue
            end
        else
            if not obj or not obj.Parent then
                Visual.Remove(seed)   -- static model/part is gone for good
                continue
            end
        end

        -- Type guard (unsupported instances are dropped)
        if not (obj:IsA("Model") or obj:IsA("BasePart")) then
            Visual.Remove(seed)
            continue
        end

        -- Resolve dynamic team color / class (only for humanoid-tracked entries)
        local dynamicColor = entry.OverriddenColor
        local pl = targetPlayer or (entry.IsHumanoid and Players:GetPlayerFromCharacter(obj))
        if pl then
            if not entry.OverriddenColor then
                dynamicColor = Visual.Settings.TeamColors[Visual.GetTeam(pl)]
            end
            local teamClass = Visual.GetTeamClass(pl)
            if teamClass then entry.ClassName = teamClass end
        end

        -- Resolve the class config ONCE (was looked up per-setting before)
        local classConfig = entry.ClassName and Visual.Classes[entry.ClassName] or nil

        -- Per-class killswitch
        if classConfig and classConfig.Enabled == false then
            hideEntry(entry)
            continue
        end

        -- Single projection pass (was 3 WorldToViewportPoint calls, now 2)
        local boxPos, boxSize, center, onScreen = computeScreenBox(camera, obj, entry.IsHumanoid)
        if not boxPos or not onScreen then
            hideEntry(entry)
            continue
        end

        ensureDrawings(entry)
        local D = entry.Drawing

        -------------------------------------------
        -- 1. BOX
        -------------------------------------------
        if resolveSetting(classConfig, dynamicColor, "Box", "Enabled") then
            D.Box.Position = boxPos
            D.Box.Size = boxSize
            D.Box.Color = resolveSetting(classConfig, dynamicColor, "Box", "Color")
            D.Box.Visible = true
        else
            D.Box.Visible = false
        end

        -------------------------------------------
        -- 2. HIGHLIGHT
        -------------------------------------------
        if resolveSetting(classConfig, dynamicColor, "Highlight", "Enabled") then
            local hlColor = resolveSetting(classConfig, dynamicColor, "Highlight", "Color")

            if not entry.HighlightInstance or not entry.HighlightInstance.Parent then
                if entry.HighlightInstance then entry.HighlightInstance:Destroy() end
                entry.HighlightInstance = Instance.new("Highlight")
                entry.HighlightInstance.Parent = LocalPlayer:WaitForChild("PlayerGui")
            end
            if entry.HighlightInstance.Adornee ~= obj then
                entry.HighlightInstance.Adornee = obj
            end
            entry.HighlightInstance.FillColor = hlColor
            entry.HighlightInstance.OutlineColor = hlColor
            entry.HighlightInstance.OutlineTransparency = 1
            entry.HighlightInstance.FillTransparency = 0.5
            entry.HighlightInstance.Enabled = true
        elseif entry.HighlightInstance then
            entry.HighlightInstance.Enabled = false
        end

        -------------------------------------------
        -- 3. HEALTH BAR
        -------------------------------------------
        if entry.IsHumanoid and resolveSetting(classConfig, dynamicColor, "Health", "Enabled") then
            local humanoid = obj:FindFirstChildOfClass("Humanoid")
            if humanoid then
                local healthPct = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
                local barWidth, padding = 2, 4
                local bgPos = Vector2.new(boxPos.X - barWidth - padding, boxPos.Y)

                D.HealthBarBG.Position = bgPos
                D.HealthBarBG.Size = Vector2.new(barWidth, boxSize.Y)
                D.HealthBarBG.Color = HEALTH_BG_COLOR
                D.HealthBarBG.Visible = true

                local barHeight = boxSize.Y * healthPct
                D.HealthBar.Position = Vector2.new(bgPos.X, bgPos.Y + (boxSize.Y - barHeight))
                D.HealthBar.Size = Vector2.new(barWidth, barHeight)
                D.HealthBar.Color = HEALTH_LOW:Lerp(HEALTH_HIGH, healthPct)
                D.HealthBar.Visible = true
            else
                D.HealthBarBG.Visible = false
                D.HealthBar.Visible = false
            end
        else
            D.HealthBarBG.Visible = false
            D.HealthBar.Visible = false
        end

        -------------------------------------------
        -- 4. TRACERS
        -------------------------------------------
        if resolveSetting(classConfig, dynamicColor, "Tracers", "Enabled") then
            D.Tracer.From = screenBottomCenter
            D.Tracer.To = Vector2.new(boxPos.X + boxSize.X * 0.5, boxPos.Y + boxSize.Y)
            D.Tracer.Color = resolveSetting(classConfig, dynamicColor, "Tracers", "Color")
            D.Tracer.Visible = true
        else
            D.Tracer.Visible = false
        end

        -------------------------------------------
        -- 5. NAMES
        -------------------------------------------
        if resolveSetting(classConfig, dynamicColor, "Names", "Enabled") then
            D.Name.Text = entry.Name
            D.Name.Color = resolveSetting(classConfig, dynamicColor, "Names", "Color")
            D.Name.Position = Vector2.new(center.X, boxPos.Y - 16)
            D.Name.Visible = true
        else
            D.Name.Visible = false
        end
    end
end)

return Visual
